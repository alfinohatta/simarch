# ==============================================================================
# Environment & Build Configuration Template
# Computer Architecture Visualizer & Simulator
# ==============================================================================

# Android SDK Path (Local Environment)
SDK_DIR=C:/Users/Username/AppData/Local/Android/Sdk

# Application Variant Configuration
BUILD_TYPE=debug
ENABLE_ANALYTICS=false
ENABLE_HAPTIC_FEEDBACK=true

# Security & Keystore Parameters (Release Build Only)
RELEASE_STORE_FILE=keystore/release.jks
RELEASE_STORE_PASSWORD=your_keystore_password
RELEASE_KEY_ALIAS=architecture_key_alias
RELEASE_KEY_PASSWORD=your_key_password
